# Claude API key for Odyssey, the AI tutor. Without it the rest of the app works and Odyssey shows as unavailable.
ANTHROPIC_API_KEY=
# Where the SQLite database and uploaded files are stored.
DATA_DIR=./data
PORT=8787
# Messages each student can send Odyssey per day (controls API cost).
ODYSSEY_DAILY_LIMIT=60
# Optional overrides.
# ODYSSEY_MODEL=claude-opus-5-5
# ODYSSEY_EFFORT=medium
